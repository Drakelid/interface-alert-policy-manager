IAPM_SMS_GATEWAY_URL=http://sms-gateway.example.internal:5000/api/v10/messages/send
IAPM_SMS_GATEWAY_USERNAME=
IAPM_SMS_GATEWAY_PASSWORD=
IAPM_SMS_DEFAULT_RECEIVER=
IAPM_SMS_SINGLE_SEGMENT=true
IAPM_INGEST_RATE=20000,1
IAPM_INGEST_ASYNC_THRESHOLD=1000
IAPM_INGEST_ASYNC_RECOVERY=true
IAPM_INGEST_MAX_PENDING=10000
IAPM_INGEST_INBOX_WORKERS=2
IAPM_INGEST_BATCH_PER_WORKER=1
IAPM_QUEUE_CONNECTION=database
IAPM_QUEUE_NAME=iapm
# 0 when systemd/Supervisor owns the workers instead of the LibreNMS scheduler.
IAPM_QUEUE_WORKERS=3
# How long without a worker consuming the once-a-minute liveness heartbeat before
# iapm:health reports the queue workers dead. Tolerates four missed ticks.
IAPM_QUEUE_HEARTBEAT_STALE_SECONDS=300
IAPM_OUTBOX_DRAIN_BATCH=1000
IAPM_RETRY_BASE_SECONDS=15
IAPM_RETRY_MAX_SECONDS=3600
