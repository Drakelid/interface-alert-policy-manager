# Keep the composer/Packagist dist install lean — these are dev-only and are
# excluded from `git archive` (what Composer downloads), but stay in a git clone.
/tests            export-ignore
/tools            export-ignore
/.github          export-ignore
phpunit.xml       export-ignore
phpunit.xml.dist  export-ignore
phpstan.neon      export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
